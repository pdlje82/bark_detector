# bark-detector.service — systemd unit file for the Bark Detector
#
# Install:
#   sudo cp bark-detector.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bark-detector
#
# Useful commands:
#   sudo systemctl status bark-detector       # check current state
#   sudo systemctl restart bark-detector      # apply config changes
#   journalctl -u bark-detector -f            # follow live logs
#   journalctl -u bark-detector --since today # view today's log

[Unit]
Description=Bark Detector — real-time dog bark detection via YAMNet TFLite
# Wait for network (needed for InfluxDB writes) and ALSA sound subsystem
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# All relative paths in the Python code resolve from here
WorkingDirectory=/home/pi/bark_detector
# Make sure the Conda environment's Python is available to the service
Environment=PATH=/home/pi/miniconda3/envs/bark-detector/bin:/home/pi/miniconda3/bin:/usr/bin:/bin
# Start command — uses the Conda environment's Python explicitly for clarity
ExecStart=/home/pi/miniconda3/envs/bark-detector/bin/python bark_detector.py
# Restart automatically if the process crashes (e.g. USB disconnect)
Restart=always
# Wait 10 seconds before each restart attempt to avoid a tight crash loop
RestartSec=10
# Route stdout/stderr to the systemd journal (visible via journalctl)
StandardOutput=journal
StandardError=journal

[Install]
# Start the service when the system reaches the normal multi-user target
WantedBy=multi-user.target
